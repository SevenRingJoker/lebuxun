{
  "name": "scholar-trea-code",
  "version": "0.1.0",
  "description": "Trae 风格的 AI 本地编辑器：Electron + Monaco + LSP + Ollama + MCP",
  "main": "./out/main/index.js",
  "author": "scholarTreaCode",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck:main": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:renderer": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pack": "node scripts/build.cjs --dir",
    "dist": "node scripts/build.cjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@modelcontextprotocol/server-filesystem": "^2026.8.31",
    "@vscode/ripgrep": "^1.18.0",
    "@vue/language-server": "2.1.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron-ollama": "^0.1.1",
    "electron-updater": "^6.8.9",
    "monaco-editor": "^0.52.2",
    "monaco-languageclient": "^9.6.1",
    "node-pty": "^1.1.0",
    "ollama": "^0.5.14",
    "pinia": "^2.2.6",
    "typescript": "^5.6.3",
    "typescript-language-server": "^4.3.4",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-ws-jsonrpc": "^3.4.0",
    "vue-i18n": "^11.4.12",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^5.2.0",
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "sass": "^1.81.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.9",
    "vue": "^3.5.43",
    "vue-tsc": "^2.1.10"
  },
  "build": {
    "appId": "com.scholar.treacode",
    "productName": "ScholarTreaCode",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "resources/**",
      "mcp-servers.json"
    ],
    "asarUnpack": [
      "node_modules/@modelcontextprotocol/server-filesystem/**",
      "node_modules/@vscode/ripgrep/**",
      "node_modules/@vscode/ripgrep-win32-x64/**",
      "node_modules/typescript/**",
      "node_modules/typescript-language-server/**",
      "node_modules/@vue/language-server/**",
      "node_modules/@vue/language-core/**",
      "node_modules/@vue/language-service/**",
      "node_modules/@vue/typescript-plugin/**",
      "node_modules/@volar/language-server/**",
      "node_modules/@volar/language-core/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ScholarTreaCode"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Development"
    },
    "publish": {
      "provider": "generic",
      "url": "https://example.com/scholar-trea-code/releases/"
    }
  }
}
